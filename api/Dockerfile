# ============================================================
#  Dockerfile של שרת ה-API (Node.js)
#  Dockerfile = "מתכון" לבניית אימג'. כל שורה היא שלב.
#  שימו לב: ב-Dockerfile הערה חייבת להיות בשורה נפרדת
# ============================================================

# שלב 1: מתחילים מאימג' מוכן שיש בו Node.js גרסה 20.
# alpine = לינוקס קטן מאוד (~50MB במקום ~1GB) – מהיר יותר ופחות חולשות אבטחה
FROM node:20-alpine

# שלב 2: קובעים את תיקיית העבודה בתוך הקונטיינר. כל הפקודות הבאות ירוצו בה
WORKDIR /app

# שלב 3: מעתיקים קודם רק את קבצי רשימת הספריות (package.json ו-package-lock.json).
# למה קודם? Docker שומר כל שלב ב-Cache. אם רק הקוד השתנה, הוא לא יתקין שוב את הספריות – הבנייה מהירה יותר
COPY package.json package-lock.json ./

# שלב 4: מתקינים את הספריות (express, redis).
# npm ci = התקנה מדויקת לפי הגרסאות ב-lock. --omit=dev = בלי כלי פיתוח שלא צריך בייצור
RUN npm ci --omit=dev

# שלב 5: עכשיו מעתיקים את הקוד עצמו
COPY server.js ./

# שלב 6: עוברים למשתמש "node" במקום root (מנהל) – אבטחה: גם אם פורצים לשרת, אין לו הרשאות מלאות
USER node

# מציינים שהשרת מאזין לפורט 3000 (תיעוד)
EXPOSE 3000

# הפקודה שרצה כשהקונטיינר מתחיל: מפעילים את השרת
CMD ["node", "server.js"]
