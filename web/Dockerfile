# ============================================================
#  Dockerfile של שרת ה-Web (Nginx)
#  Dockerfile = "מתכון" לבניית אימג'. כל שורה היא שלב.
#  שימו לב: ב-Dockerfile הערה חייבת להיות בשורה נפרדת
# ============================================================

# שלב 1: מתחילים מאימג' מוכן של Nginx. alpine = גרסה קטנה וקלה של לינוקס
FROM nginx:alpine

# שלב 2: מעתיקים את קובץ ההגדרות שלנו לתוך הקונטיינר, במקום ההגדרות הרגילות של Nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

# שלב 3: מעתיקים את לוח הבקרה לתיקייה ש-Nginx מגיש ממנה קבצים
COPY index.html /usr/share/nginx/html/index.html

# מציינים שהקונטיינר מאזין לפורט 80 (זה תיעוד; את החיבור למחשב עושים ב-docker-compose)
EXPOSE 80
